# MLflow tracking store (utils/tracking.py, scripts/mlflow_server.sh)
mlflow.db
mlflow.db-journal
mlartifacts/
mlruns/
logs/

# datasets (downloaded and processed on first use) and run outputs; the upstream MUTAG
# files tracked before stay tracked
/data/*
!/data/MUTAG/
/results/
/results_*/
/figures/*/
# PLEX/ is a separate nested clone (CLAUDE.md)
/PLEX/

# teacher bundles for other machines (python -m utils.teachers pack)
bundles/
# hyper-parameter studies (utils/hps.py)
results_hps/

# Python / Jupyter caches
__pycache__/
*.pyc
.ipynb_checkpoints/
# build products of deps/ (rebuilt by pip install deps/pygcanl)
deps/*/build/
deps/*/*.egg-info/
